# Copy to backend/.env and adjust. Never commit .env.
SECRET_KEY=dev-only-insecure-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgis://medilink:medilink@localhost:5432/medilink
REDIS_URL=redis://localhost:6380/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Phase 0 behaviour
DEFAULT_SEARCH_RADIUS_M=5000
MIN_SERVICE_TIME_SAMPLES=20

# Phase 3 - USSD and WhatsApp.
# These checks FAIL CLOSED: a blank secret rejects every webhook, in
# development as much as in production. An unauthenticated USSD endpoint
# would let anyone act as any phone number. Use a throwaway value locally.
USSD_SHARED_SECRET=dev-ussd-secret
USSD_ALLOWED_IPS=
WA_VERIFY_TOKEN=dev-verify-token
WA_APP_SECRET=dev-app-secret
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# Phase 2 - SMS. Console backend prints instead of sending.
SMS_BACKEND=apps.notifications.sms.ConsoleSMSBackend
SMS_SENDER_ID=MEDILINK
LEAVE_BY_BUFFER_MINUTES=10
NATIONAL_ID_PEPPER=change-me-and-never-rotate-casually

# Phase 4 - triage. LEAVE THESE BLANK.
# The symptom checker returns 503 until all four are set, and they must
# only be set once a named, licensed clinician has reviewed and signed off
# a specific protocol version. See docs/08 section 8.
TRIAGE_PROTOCOL_VERSION=
TRIAGE_APPROVED_BY=
TRIAGE_APPROVED_ON=
TRIAGE_PROTOCOL_FILE=
