  "conditions": [
    {
      "_note": "Named for the presentation, not the pathogen. Distinguishing malaria from typhoid needs a blood test, and this app cannot do one.",
      "code": "febrile_illness",
      "names": {
        "rw": "Umuriro ukeneye gusuzumwa",
        "en": "Fever needing assessment",
        "fr": "Fievre a evaluer"
      },
      "weights": {
        "sym_fever": 4,
        "sym_headache": 2,
        "sym_vomiting": 1
      },
      "service": "general_consultation",
      "advice": {
        "rw": "Umuriro ukwiye gupimwa. Amavuriro menshi afite laboratwari isuzuma mu minota mike.",
        "en": "A fever should be tested. Most facilities can run a blood test in minutes.",
        "fr": "Une fievre doit etre testee. La plupart des centres font une analyse en quelques minutes."
      }
    },
    {
      "code": "respiratory_infection",
      "names": {
        "rw": "Indwara y'ubuhumekero",
        "en": "Chest or throat infection",
        "fr": "Infection respiratoire"
      },
      "weights": {
        "sym_cough": 4,
        "sym_fever": 2
      },
      "service": "general_consultation",
      "advice": {
        "rw": "Inkorora imaze iminsi irenga irindwi, cyangwa iherekejwe n'umuriro, ikwiye gusuzumwa.",
        "en": "A cough lasting more than a week, or with fever, should be checked.",
        "fr": "Une toux de plus d'une semaine, ou avec fievre, doit etre examinee."
      },
      "requires": [
        "sym_cough"
      ]
    },
    {
      "code": "gastrointestinal_illness",
      "names": {
